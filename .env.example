# Sanketika Environment Variables Configuration

# -------------------------------------------------------------
# Web Application (Next.js) Settings
# -------------------------------------------------------------
PORT=3005
NODE_ENV=development

# URL to the Python FastAPI Machine Learning & Accessibility Backend
# Local default: http://127.0.0.1:8008
# Production example: https://api.sanketika.org
BACKEND_URL=http://127.0.0.1:8008

# -------------------------------------------------------------
# Python Backend Settings (backend_server.py)
# -------------------------------------------------------------
BACKEND_PORT=8008
BACKEND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3005,http://localhost:3000,http://127.0.0.1:3005
